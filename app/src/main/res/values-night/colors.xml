<?xml version="1.0" encoding="utf-8"?>
<!--
  Bảng màu TỐI của theme cửa sổ.
  Hai tệp `values/` (SÁNG) và `values-night/` (TỐI) khai CÙNG bộ tên màu, chỉ khác giá trị. Chỉ còn các màu mà
  theme cửa sổ · drawable (`popup_bg` · `spinner_*` · `window_bg` · `launcher_*`) dùng; Android box B2 · W4 gỡ màu của
  màn ClusterNav cũ (thẻ tính năng · ghế · xem trước cụm · nút Cockpit).
-->
<resources>
    <color name="brand">#3b82f6</color>          <!-- blue -->
    <color name="surface">#14151d</color>         <!-- card surface -->
    <color name="screen_bg">#07070b</color>       <!-- cockpit window background -->
    <color name="text_primary">#f4f5fb</color>    <!-- light ink -->
    <color name="text_secondary">#9a9db0</color>  <!-- muted ink -->
    <color name="ok_green">#34d399</color>        <!-- green -->
    <color name="surface_2">#191b25</color>       <!-- lighter card surface (gradient top) -->
    <color name="hairline">#242634</color>        <!-- default hairline -->
    <color name="hairline_strong">#2e3140</color> <!-- stronger card stroke -->
    <color name="cockpit_bg_tint">#4d3b82f6</color> <!-- ~30% blue radial tint for window bg (top-left) -->
    <color name="cockpit_bg_tint_purple">#3aa78bfa</color> <!-- ~23% purple radial tint for window bg (top-right) -->
    <color name="text_tertiary">#63667a</color>   <!-- tertiary ink -->
    <color name="ripple_light">#33ffffff</color>  <!-- subtle light ripple on dark -->
    <color name="press_blue">#223b82f6</color>    <!-- translucent blue press overlay -->
</resources>
