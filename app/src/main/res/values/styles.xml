<?xml version="1.0" encoding="utf-8"?>
<!--
  Kiểu widget FRAMEWORK của theme cửa sổ (`themes.xml` gắn qua `android:spinnerStyle` · `spinnerDropDownItemStyle` ·
  `dropDownListViewStyle` · `seekBarStyle`). Giao diện launcher dựng bằng mã (`KachiTheme` · `SettingsRows`), không dùng
  tệp này. Android box B2 · W4: gỡ bộ kiểu "Cockpit" của màn ClusterNav cũ (chữ · nút · thẻ · hàng · hero) — chỉ
  layout `activity_main.xml` đã xoá ở W2a dùng chúng.
-->
<resources>

    <!-- Cockpit.Spinner — the dropdown control face. Rounded surface_2 field + hairline_strong stroke +
         end chevron (@drawable/spinner_bg); the popup opens on the dark @drawable/popup_bg panel. paddingEnd
         clears the chevron; overlapAnchor=false drops the list BELOW the field. Wired app-wide via AppTheme
         android:spinnerStyle, so ALL framework Spinners adopt it. -->
    <style name="Cockpit.Spinner" parent="@android:style/Widget.Material.Spinner">
        <item name="android:background">@drawable/spinner_bg</item>
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Cockpit.Spinner.Item — the COLLAPSED selected row (see @layout/cockpit_spinner_item). parent="" so it
         does NOT inherit the Cockpit.Spinner widget style. Horizontal padding comes from Cockpit.Spinner; this
         owns ink + vertical rhythm + single-line ellipsize. -->
    <style name="Cockpit.Spinner.Item" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Cockpit.Spinner.DropDownItem — a popup ROW (see @layout/cockpit_spinner_dropdown_item). Also wired as
         AppTheme android:spinnerDropDownItemStyle for any future default-adapter spinner. parent="" (no radio
         checkMark); selectable @drawable/spinner_item_bg gives the pressed/selected blue wash; touch_min tall. -->
    <style name="Cockpit.Spinner.DropDownItem" parent="">
        <item name="android:background">@drawable/spinner_item_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Cockpit.DropDownListView — the ListView inside a Spinner popup. No visible divider + transparent
         listSelector, because each row owns its own pressed wash (spinner_item_bg). Wired via AppTheme
         android:dropDownListViewStyle. -->
    <style name="Cockpit.DropDownListView" parent="@android:style/Widget.Material.ListView.DropDown">
        <item name="android:divider">@color/hairline</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
    </style>

    <!-- Cockpit.SeekBar — value slider (e.g. badge size). Active fill + thumb are GREEN (@color/ok_green) to
         match the switch family; the unfilled track is a subtle hairline. Explicit tints so the look is not
         theme-implicit. Wired app-wide via AppTheme android:seekBarStyle. -->
    <style name="Cockpit.SeekBar" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:progressTint">@color/ok_green</item>
        <item name="android:thumbTint">@color/ok_green</item>
        <item name="android:progressBackgroundTint">@color/hairline_strong</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>
</resources>
