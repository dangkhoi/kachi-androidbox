<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2026-08-22: gỡ READ_LOGS. Quyền này chỉ để đọc tag logcat WazeHudLink của WazeMod (nguồn HLP) —
         nguồn đó đã gỡ vì đo được 0 dòng khi không có HUD BLE. Không code nào của app đọc logcat nữa
         (nhật ký chẩn đoán do app tự ghi ra file, không đọc ngược logcat). -->
    <!-- Tự rebind nav listener sau khi khởi động lại máy (RebindReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ADB loopback (socket 127.0.0.1:5555) để rebind listener từ trong app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nút nổi (bubble) đưa GMaps lên cluster: vẽ overlay trên app khác + foreground service giữ nút sống. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- V1 pha NGHE (R13) — micro cho phiên "bấm-để-nói". Nhận dạng chạy TẠI MÁY (Vosk, mô hình trong
         filesDir); âm thanh KHÔNG rời khỏi tiến trình: `VoiceCommandWiringContractTest` cấm mọi socket/HTTP
         trong tệp `Voice*`. Đây là quyền RUNTIME nên app tự cấp qua kênh dadb loopback
         (`pm grant … RECORD_AUDIO`, cùng đường với ba quyền kiểu ADB khác — xem `PermissionPreflight`);
         thiếu thì phiên nghe nói rõ lý do thay vì im lặng.
         `android.hardware.microphone` khai `required=false`: đầu xe nào không có mic thì app vẫn cài được,
         chỉ mất đúng tính năng này. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android box B3: OTA khi KHÔNG có kênh shell ⇒ trình cài app của hệ thống (người dùng bấm Cài; hệ thống tự
         hỏi "cho phép cài từ nguồn này"). Có kênh thì vẫn `pm install -r` qua dadb như cũ (UpdateFlow / NoShellFallback.otaRoute). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AUTOMATION #2 (1.85, spec kachi-automation R3) — CỔNG "có định vị chưa" cho luật dẫn-đường-theo-lịch.
         Usecase hầm (R2.4): vẫn trong khung 7–9h, chờ ra khỏi hầm có GPS mới dẫn. `isProviderEnabled` một mình
         KHÔNG trả lời được (trong hầm provider vẫn BẬT, chỉ không có fix) ⇒ phải hỏi TUỔI của fix gần nhất, và
         đó là thứ cần quyền này.

         ⚠⚠ CHỈ ĐỌC — đây là bất biến an toàn, không phải một lựa chọn phong cách. Ngày 2026-07-27 owner bỏ hẳn
         đường ghi vị trí giả vì nó GHIM GPS CỦA CẢ XE. Kachi KHÔNG BAO GIỜ được:
           • dựng test-provider hay ghi vị trí giả,
           • bám định vị liên tục (đăng ký nhận cập nhật / listener),
           • xin thêm bất kỳ quyền định vị nào khác (thô, nền, hay quyền foreground-service định vị).
         Cả sáu điều trên bị hai bài canh trong `app/src/test/java/com/byd/clusternav/` khoá (lớp canh việc gỡ
         nguồn vị-trí-giả năm 2026-07). ⚠ Hai bài đó GIỮ
         DANH SÁCH TÊN QUYỀN và quét chính tệp này, nên KHÔNG viết lại tên các quyền ấy ở đây — viết ra là tự làm
         đỏ bài canh. Đường đọc duy nhất là `GpsAvailability` (`isProviderEnabled` + `getLastKnownLocation`, đọc
         lại chính cái fix mà app dẫn đường đang chạy đã tạo ra).

         Quyền RUNTIME, tự cấp qua kênh dadb loopback (`pm grant … ACCESS_FINE_LOCATION`) — cùng đường
         RECORD_AUDIO, xem `LauncherRequirements.LOCATION` + `PermissionPreflight`. Thiếu ⇒ cổng GPS trả
         "chưa biết" và luật chờ-GPS **không dẫn bừa**; hàng quyền trong Cài đặt nói ra lý do. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- COARSE đi kèm FINE (lint CoarseFineLocation; Android 12+ bỏ qua lời xin FINE đơn lẻ). Vẫn chỉ ĐỌC — spec
         `kachi-rain-defrost-and-rebind.html` R5/§4.7 (owner 2026-09-16); mock/background/FGS-location vẫn CẤM
         (bài canh quyền định vị chỉ-ĐỌC ở app/src/test). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- W-WAKE: FGS thu micro (VoiceWakeService, type=microphone). API 34+ đòi quyền này; API 29 (xe) bỏ qua. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- liệt kê app cho picker "Chiếu app lên cụm". API29 không lọc; thêm để chắc trên API30+ (app sideload cá nhân). -->
    <!-- Personal sideloaded app manager intentionally enumerates the full installed catalog. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- BYD privileged deployment may grant host binding; runtime still uses user-confirmed binding. -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <!-- 2026-09-09: NHÚNG app vào ô workspace (ActivityView, kiểu AAOS CarLauncher) — app render fullscreen trên
         virtual display cỡ ô (KHÔNG caption, lọt khít khung, bo góc được), Kachi vẽ nút ⇄/✕ đè lên. Các quyền này
         là signature|privileged: chỉ được cấp khi Kachi chạy như LAUNCHER HỆ THỐNG (priv-app trên xe / /system/priv-app
         trên emulator + allowlist). Sideload thường KHÔNG được cấp → SlotAppHost degrade về freeform. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACTIVITY_EMBEDDING" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" tools:ignore="ProtectedPermissions" />

    <!-- allowBackup=false: app lưu ADB private key (adb.key/adb.pub) trong filesDir — key này grant shell
         localhost:5555. Bật backup sẽ để `adb backup`/auto-backup rút key ra ngoài → tắt để không lộ. -->
    <application
        android:name=".KachiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Android box B2 · W1: hai màn chẩn đoán BYD (DiagActivity cụm · VietMapWidgetDiagActivity) gỡ khỏi manifest. -->
        <!-- BEHIND-HOME (spec kachi-launcher-shortcuts-autostart §4.2.5): activity GIỮ CHỖ — không bao giờ chạy khi
             mọi thứ đúng (khoá avoidMoveToFront ⇒ mDoResume=false); chỉ để có một stack S nằm đáy display 0. Chạy thật
             ⇒ ROM bỏ qua khoá ⇒ tự báo + tự gỡ. Không exported: chỉ chính Kachi mở. -->
        <activity
            android:name=".launcher.behind.BehindAnchorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.byd.clusternav.behind"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- L4 · D2(a) — lớp che trên màn ảo dàn dựng ẨN của Kachi (StagingDisplay): đóng vai app của ô để X không ở đỉnh
             màn ảo lúc move-task (R0.2). Chỉ chính Kachi mở, lên màn ảo của chính Kachi; gỡ ngay sau lượt đẩy. -->
        <activity
            android:name=".launcher.behind.StageCoverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:taskAffinity="com.byd.clusternav.stage"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- ⚠ `.MainActivity` (màn ClusterNav cũ) đã GỠ 2026-09-13 — docs/specs/kachi-remove-legacy-screen.html
             R1. Mọi intent tường minh từng trỏ tới nó (RebindReceiver, UpdateRelaunch, thông báo của
             FloatingBubbleService, menu bong bóng › Cấu hình) nay trỏ `.launcher.KachiHomeActivity`, kèm extra
             `open_settings_group` khi có nhóm Cài đặt tương ứng. Bài `LegacyScreenAbsenceContractTest` canh
             chiều "không mọc lại". Ghi chú size-compat cũ (dudu) đi theo màn đó:
             docs/diagnostics/dudu-mainactivity-sizecompat-2026-08-14.md. -->

        <!-- Kachi HOME (P1) + LAUNCHER (IA v2): màn hình chính launcher và cũng là ICON DUY NHẤT của APK trong ngăn
             kéo (SingleLauncherIconContractTest khoá: đúng một category LAUNCHER trong manifest chính, ở activity này).
             CATEGORY_HOME để chọn Kachi làm màn chính. Landscape. -->
        <activity
            android:name=".launcher.KachiHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|density|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <!-- CHỈ MAIN+LAUNCHER ở activity: Kachi CÀI NHƯ APP THƯỜNG. HOME nằm trên alias TẮT SẴN bên dưới.
                 [ĐO on-car 2026-09-15] BYD packageinstaller (StopLauncherActivity/LAUNCHER_INSTALLER) chặn GUI-install
                 app có HOME đang bật → Kachi (HOME bật sẵn) fail GUI, bỏ HOME thì cài được. Owner [ĐO] DuDu: "cài vào là
                 app bình thường, sau đó chọn làm launcher mới hiện option chọn launcher3/DuDu" ⇒ HOME chỉ được BẬT lúc
                 runtime (DefaultHome.enableHomeEntry) — khi đó hệ thống có ứng viên home mới → hộp chọn hiện. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lối vào HOME của Kachi — alias TẮT SẴN (enabled=false), KHÔNG mang LAUNCHER (một icon duy nhất —
             SingleLauncherIconContractTest). Bật bằng DefaultHome.enableHomeEntry() từ nút "Đặt làm màn hình chính"
             (và re-apply sau nâng cấp nếu người dùng đã chọn). `cmd package set-home-activity` nhắm component alias này. -->
        <activity-alias
            android:name=".launcher.KachiHome"
            android:targetActivity=".launcher.KachiHomeActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>


        <!-- ⚠ [ĐO xe 2026-09-15] KHÔNG thêm `<property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE">`
             vào các service `specialUse` dưới đây. `<property>` là tag API 34; PackageParser CLIENT-SIDE của
             `com.android.packageinstaller` trên Android 10 (xe DL3) KHÔNG hiểu ⇒ "Unknown element under <service>:
             property" ⇒ trình cài GUI báo "Fail in installation of desktop apps" (log: PackageParser pid 27089).
             `adb pm install` (parser server-side) bỏ qua nên vẫn cài được — đúng triệu chứng "adb được, GUI không".
             Xe chạy ≤ Android 12 (API 31) nên property này (chỉ bắt buộc từ API 34) là thừa. Nếu lint đòi → suppress,
             KHÔNG thêm lại property. -->
        <!-- Android box B2 · W1: nút nổi chiếu cụm (FloatingBubbleService), lượt tự chiếu (CastAutomationService), màn đen
             chiếu cụm (ClusterBlackActivity), thẻ dẫn đường dự phòng trên cụm (ClusterNavActivity) và tự mở VietMap
             (VietMapAutostartService) gỡ khỏi manifest — phần chỉ-BYD (docs/specs/androidbox-plan.html §4.1). -->
        <!-- 1.21 Item 1: HEADLESS boot setup — accessibility grant + force-bind (physical keys) + voice-key keep-alive +
             scheduled-nav engine, off any screen so boot doesn't foreground the app. Android box B2 · W1: the cluster /
             VietMap / comfort work that used to run here is gone. Short-lived; started by RebindReceiver when "Tự khởi
             động nền" is ON. Never exported. -->
        <service
            android:name=".BootSetupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
        </service>

        <!-- FGS mảnh giữ tiến trình sống khi phím-thoại bật → ssc_skip không DROP watchdog broadcast
             (deep-pass 2026-09-23 [P1] #3). IMPORTANCE_MIN, không mic. Never exported. -->
        <service
            android:name=".VoiceKeyKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
        </service>

        <!-- AUTOMATION (1.85, spec kachi-automation R4): động cơ nền của "tự dẫn đường theo lịch" (nhịp ~1 phút).
             Android box B2 · W1: nhịp "tự sấy kính khi mưa" (HAL BYD) đã gỡ khỏi vòng. KHÁC ba service trên: chúng là việc
             MỘT LẦN rồi tự chết, còn cái này là một nhịp DÀI HẠN (cả chuyến) ⇒ `START_STICKY`.
             Chỉ sống khi có ít nhất một automation BẬT (`AutomationService.anyEnabled`); hết việc thì tự
             `stopSelf`. Started/stopped bởi `AutomationService.sync()` (công tắc UI + boot). Never exported.
             `specialUse` như BootSetup/VietMap: nó KHÔNG thu micro, KHÔNG bám định vị liên tục — chỉ đọc
             `getLastKnownLocation` theo nhịp, nên không cần type `location` (và không xin quyền
             foreground-service định vị — xem khối quyền ở đầu manifest). -->
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
        </service>

        <!-- W-WAKE (2026-09-18): "Hey Kachi" — FGS micro nền nghe câu gọi (owner: nghe cả khi launcher không hiện).
             Gate màn-sáng + load-guard (lá chắn CPU chính). Mặc định TẮT (opt-in); started/stopped by
             VoiceWakeService.sync() theo công tắc + boot. Never exported.
             ⚠ Type = `microphone`, KHÔNG `specialUse` như các FGS khác: đây là FGS **duy nhất thu micro**, và
             `microphone` là hằng có từ API 29 (đúng ROM xe) đồng thời là type **bắt buộc** cho việc thu nền từ
             API 30+ (`specialUse` ở đó không cho quyền mic). Kèm `FOREGROUND_SERVICE_MICROPHONE` — API 34+ ném
             SecurityException nếu thiếu; API 29 bỏ qua tên quyền không biết nên vô hại trên xe.

             ⚠ 2026-09-19 (crowd-test): CHẠY Ở TIẾN TRÌNH RIÊNG `:wake`, **cùng lẽ với `:tts` của 1.79**. Bộ nghe
             câu gọi cầm `KeywordSpotter` của sherpa-onnx — tức cùng một thư viện native (`libonnxruntime.so`) mà
             [ĐO tombstone xe 2026-09-18] đã một lần SIGSEGV trong `OfflineTts.generate` và giết CẢ tiến trình
             launcher (⇒ a11y unbind ⇒ phím gán chết). Một SIGSEGV native KHÔNG bắt được bằng `runCatching` trong
             cùng tiến trình, nên ranh giới tiến trình là bản vá duy nhất khả thi. Nay KWS nổ thì chỉ `:wake` chết;
             launcher + phím gán + màn hình sống nguyên. Hậu tố khai MỘT chỗ ở `VoiceWakeService.PROCESS_SUFFIX`.
             Giữ khối ĐƠN GIẢN (xem cảnh báo `<property>` ở trên). -->
        <service
            android:name=".launcher.voice.VoiceWakeService"
            android:process=":wake"
            android:exported="false"
            android:foregroundServiceType="microphone">
        </service>

        <!-- #0 (2026-09-18): PIPER TTS Ở TIẾN TRÌNH RIÊNG `:tts`.
             [ĐO tombstone xe, docs/diagnostics/oncar-piper-crash-binding-2026-09-18.md] `OfflineTts.generate`
             SIGSEGV (SEGV_MAPERR, luồng KachiSpeak) → chết CẢ tiến trình launcher → NavAccessibilityService
             unbind → rebind kẹt "Binding" → PHÍM GÁN CHẾT. SIGSEGV native không bắt được bằng runCatching trong
             cùng tiến trình ⇒ ranh giới tiến trình là bản vá duy nhất khả thi. Nay Piper nổ thì chỉ `:tts` chết;
             launcher thấy onServiceDisconnected và mở mọi chỗ đang chờ (RemotePiperSpeaker).
             KHÔNG foreground (chỉ sống khi có ai bind), KHÔNG exported. Hậu tố tiến trình khai một chỗ ở
             PiperTtsService.PROCESS_SUFFIX — KachiApplication so bằng chính hằng đó để không nạp mô hình NGHE
             trong `:tts`. Giữ ĐƠN GIẢN (xem cảnh báo <property> ở trên: packageinstaller Android 10 không hiểu
             element lạ dưới <service>). -->
        <service
            android:name=".launcher.voice.PiperTtsService"
            android:process=":tts"
            android:exported="false">
        </service>

        <!-- B6 (launcher): Kachi auto-start — surface-INDEPENDENT boot orchestration (seed freeform + set-home +
             cast-coordination plan + ensure the HOME activity is up so it restores + mounts the saved workspace).
             Does NOT mount slots (VirtualDisplays are surface-bound → they live in KachiHomeActivity). Short-lived;
             started by RebindReceiver on BOOT_COMPLETED / MY_PACKAGE_REPLACED. Never exported. -->
        <service
            android:name=".KachiAutostartService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
        </service>

        <!-- VietMap HUD BLE bridge: removed — same-device BLE self-loopback not viable (2026-08-04) -->

        <!-- Lắng nghe notification dẫn đường -->
        <service
            android:name=".NavNotificationListener"
            android:exported="false"
            android:label="@string/nav_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SELF-HEAL: tự bind lại nav listener sau khi cài đè / cập nhật / khởi động máy
             → KHÔNG còn phải mở app hay disallow→allow tay để lấy lại nav. -->
        <receiver
            android:name=".RebindReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="com.byd.clusternav.REBIND_WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- T-BRIDGE (docs/specs/kachi-test-bridge.html): cầu kiểm thử qua adb.
             exported=true BẮT BUỘC — [ĐO] uid shell (2000) KHÔNG gửi được vào receiver non-exported
             (SecurityException), cùng họ với ca `am start` ở `.ClusterNavActivity` đã ghi 2026-07-20.
             ⚠ Vì exported nên mọi app trên xe bắn vào được; cổng thật là công tắc "Chế độ kiểm thử qua adb"
             (Cài đặt › Hệ thống & quyền › Nâng cao) — tự tắt sau 60 phút HOẶC khi tắt máy (2.93 TEST-MODE-ACC-OFF:
             claim tắt-máy của lớp 1, vì tắt máy BYD không đổi boot_id), KHÔNG bật được bằng broadcast.
             Tắt ⇒ mọi lệnh trả `test_mode_off` và không nhánh nào chạy (KachiTestBridge).
             Action dùng ${applicationId} để tên gói là MỘT nguồn cho cả manifest lẫn KachiTestBridge.action().
             lint ExportedReceiver: KHÔNG thêm android:permission — uid shell (2000) không giữ được permission tự
             khai ⇒ chặn luôn adb, mất mục đích cầu; cổng thật là công tắc test-mode ở trên. -->
        <receiver
            android:name=".launcher.testbridge.KachiTestBridge"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.TEST" />
            </intent-filter>
        </receiver>

        <!-- MODULE navaccess (booster): đọc UI GMaps trên màn -> tinh chỉnh cự ly tới rẽ. User tự bật trong
             Cài đặt > Hỗ trợ. Xoá module navaccess → xoá dòng <service> này + res/xml/nav_accessibility_config.xml. -->
        <service
            android:name=".modules.navaccess.NavAccessibilityService"
            android:exported="false"
            android:label="@string/acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_accessibility_config" />
        </service>

        <!-- Android box B3 — chia sẻ APK OTA đã tải (CHỈ filesDir/update/, res/xml/ota_paths.xml) cho trình cài hệ thống.
             Không exported; quyền đọc URI cấp theo từng ý-định (grantUriPermissions). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ota"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ota_paths" />
        </provider>
    </application>
</manifest>
